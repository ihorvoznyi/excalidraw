{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "installCommand": "yarn install",
      "rewrites": [{ "source": "/s/(.*)", "destination": "/index.html" }],
      "outputDirectory": "excalidraw-app/build"
    },
    "dev-docs": {
      "root": "dev-docs",
      "framework": "docusaurus-2"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
