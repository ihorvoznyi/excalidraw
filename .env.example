# Required. Your Firebase project's web app config as one-line JSON: Firebase console → Project settings → Your apps → Web app → SDK setup and configuration → Config. Put it in .env.local (overrides .env.development/.env.production).
VITE_APP_FIREBASE_CONFIG='{"apiKey":"...","authDomain":"<project>.firebaseapp.com","projectId":"<project>","storageBucket":"<project>.firebasestorage.app","messagingSenderId":"...","appId":"..."}'
